<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Target Name="RequireEditor" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityEditorRoot)/Resources/Scripting/Managed/Newtonsoft.Json.dll')" Text="Set UnityEditorRoot to the editor's Contents/Data directory, or run Tools/unity.py serialization-check." />
  </Target>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="SerializationChecks.cs" />
    <Compile Include="../Assets/Scripts/Runtime/CompetitionSaveStore.cs" />
    <Reference Include="$(UnityEditorRoot)/Resources/Scripting/Managed/Newtonsoft.Json.dll" />
    <None Include="../Assets/Resources/Data/classic_reference.json" Link="classic_reference.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
